import ProofForge.Wasm.Host

/-!
# XRPL Bedrock host contract

XLS-0102 wasm 级 ABI，注入家族共享 WAT 发射器：

- import 模块 `host_lib`
- 读数据所有者：`get_current_ledger_obj_field(sfOwner=524290, …)`
  （ContractCall 的 home 对象是 Contract SLE；`ContractData` 挂在
  Owner 名下，因为合约 AccountRoot 余额为 0，不够 reserve）
- 槽：`get/set_data_object_field`，key 是槽名，UINT64 写 `0x03` + 大端 8 字节
  （本 Bedrock 镜像的 `update_data` 不落账本）
- 入口参数：`function_param(index, STI_UINT64=3, ptr, len) -> i32`。
  export 无 wasm 参数；UINT64 不作为 `(param i64)` 传入。
- 缺存储：`-1` INTERNAL、`-2` FIELD_NOT_FOUND、`-17` INVALID_FIELD 当零。
-/

namespace ProofForge.Wasm.Xrpl.Host

open ProofForge.Wasm.Host (Contract)

/-- The XRPL Bedrock host contract. -/
def contract : Contract where
  name := "xrpl"
  digestDomain := "xrpl-bedrock|"
  headerTag := "PROOF-FORGE-XRPL-BEDROCK v0"
  headerNotes := #[
    ";; Generated by ProofForge. Target: XRPL Bedrock (XLS-0101).",
    ";; Artifact: WAT → wasm. Host: `host_lib` (Bedrock local ABI).",
    ";; Storage: get/set_data_object_field, UINT64 STI 3 big-endian.",
    ";; Params: function_param copies UINT64 (STI 3) into linear memory;",
    ";; exports take no wasm arguments.",
    ";; Honesty: deployable=false on mainnet; no ContractCreate / AlphaNet claim.",
    ";; v0 ABI: views return i64; mutating entries return i32 status",
    ";; (error codes: 1 overflow/underflow, 2 divide-by-zero)."
  ]
  importModule := "host_lib"
  homeLeField := "get_current_ledger_obj_field"
  setData := "update_data"
  sfieldData := 458779
  functionParam := "function_param"
  stiUint64 := 3
  missingFields := #[-1, -2, -17]
  getDataObject := "get_data_object_field"
  setDataObject := "set_data_object_field"
  sfieldAccount := 524290

end ProofForge.Wasm.Xrpl.Host
