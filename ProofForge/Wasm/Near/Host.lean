  ";; Artifact: WAT → wasm. Host: `env` (near-wasm-raw-u64-v1).",
  ";; Storage: storage_read / storage_write, 8-byte LE per UInt64 slot.",
  ";; Input: env.input exactly 8*N LE bytes; views value_return 8-byte LE.",
  ";; Honesty: deployable=false; no nearcore / near-sandbox / testnet claim."
]

def importModule : String := "env"

end ProofForge.Wasm.Near.Host
